<resources>
    <string name="app_name">Cupera Launcher</string>
    <string name="badge_access">Cupera Launcher badges</string>
    <style name="Theme.Cupera" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#22263A</item>
        <item name="android:colorAccent">#4479F0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.Cupera.Home" parent="@style/Theme.Cupera">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
</resources>
